# Xcode
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
build/

# Android Studio / Gradle
.gradle/
local.properties
*.iml
.idea/
*.jks
.cxx/

# Local configuration
ios/Local.xcconfig
android/oauth.properties
.DS_Store

# Claude Code runtime
.claude/
ios/build-sim/
.wrangler/

# Xcode per-user state (scheme order, workspace UI) — meaningless off this machine
ios/**/xcuserdata/

# Local output of the workout-image review scripts in scripts/; never committed
/artifacts/

# Stray compiler output at the repo root (e.g. `swiftc test.swift` -> ./test).
# A Mach-O binary was once committed this way; keep it out.
/test

# Local screenshot captures (scripts/screenshots/capture-ios.sh default output)
scripts/screenshots/out/

# The 1.2 GB authored workout-frame corpus is only needed for Debug sample
# builds and local QA; Release archives bundle the manifest alone. Keeping it
# out keeps this sideload fork clonable and the IPA build fast.
/shared/workout-vectors/*.png

